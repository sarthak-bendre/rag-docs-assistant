# Answer-generation LLM: "ollama" (local) or "groq" (free-tier API)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
# For groq, e.g.: LLM_PROVIDER=groq  LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# RAGAS judge LLM (a larger model gives far more reliable faithfulness scores)
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b

OLLAMA_BASE_URL=http://localhost:11434

EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

CHUNK_TOKENS=500
CHUNK_OVERLAP=80

# Keep downloaded models on D:
HF_HOME=D:/Coding/.cache/huggingface
# Models are cached locally; skip Hugging Face network checks (set to 0 to download a new model)
HF_HUB_OFFLINE=1
